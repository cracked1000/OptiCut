# OptiCut Backend — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to Git!

# Your Alchemy API Key (from https://dashboard.alchemy.com)
ALCHEMY_API_KEY=your_alchemy_key

# Your deployer wallet private key (64 hex chars, no 0x prefix)
# Go to MetaMask > Account Details > Show Private Key
DEPLOYER_PRIVATE_KEY=your_private_key_64_chars
